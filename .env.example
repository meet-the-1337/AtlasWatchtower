# ============================================
# Atlas Watchtower — Environment Variables
# ============================================
# Copy this file to .env and fill in the values you need.
# All keys are optional — the dashboard works without them,
# but the corresponding features will be disabled.
#
#   cp .env.example .env
#
# ============================================


# ------ AI Summarization ------

# Groq API (primary — 14,400 req/day on free tier)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter API (fallback — 50 req/day on free tier)
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=


# ------ Cross-User Cache (Upstash Redis) ------

# Used to deduplicate AI calls and cache risk scores.
# Create a free Redis database at: https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------ Market Data ------

# Finnhub (stock quotes — free tier available)
# Register at: https://finnhub.io/
FINNHUB_API_KEY=


# ------ Energy Data ------

# U.S. Energy Information Administration
# Register at: https://www.eia.gov/opendata/
EIA_API_KEY=


# ------ Economic Data ------

# FRED (Federal Reserve Economic Data)
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=


# ------ Internet Outages ------

# Cloudflare Radar API
CLOUDFLARE_API_TOKEN=


# ------ Aircraft Tracking ------

# AISStream API key for vessel positions
# Get yours at: https://aisstream.io/
AISSTREAM_API_KEY=

# OpenSky Network credentials
# Register at: https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# ------ Map Tiles ------

# MapTiler API key (enables Google Maps-level detail)
# Free tier: 100k tile loads/month
# Get yours at: https://cloud.maptiler.com/
VITE_MAPTILER_KEY=


# ------ Site Configuration ------

# Site variant: "full" (default) | "tech" | "finance"
VITE_VARIANT=full

# Map mode: "3d" (default) | "flat"
VITE_MAP_INTERACTION_MODE=3d

# Sentry DSN (optional error tracking)
VITE_SENTRY_DSN=

# PostHog analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
